# Copy this file to .env, or just run ./setup.sh / ./setup-standalone.sh,
# which does this for you automatically.

# Where the backend API is running. If you're running school-backend
# locally via its own setup.sh, this is correct as-is. setup-standalone.sh
# overwrites this to point at the mock API server instead.
VITE_NODE_HOST_APP=http://localhost:8000

# Port the mock API server listens on when you run ./setup-standalone.sh
# or `npm run mock-api` directly (mock-server/server.js). Not read by
# Vite/the app itself - only by that script.
MOCK_API_PORT=8001

# Firebase project config (real-time chat/notifications, and the
# optional custom-token sign-in staff login attempts - see
# store/auth/authSlice.js's own comment on why a failure there never
# blocks login). Ask a maintainer for real values, or leave these unset:
# the app still runs and logs in fine without them - see
# school-backend's scripts/generate-dev-firebase-key.js for why.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Sentry DSN for browser error tracking (src/utilities/errorTracking.js).
# Leave unset to disable error reporting entirely - the app runs fine
# without it, errors just stay local to the browser console.
VITE_SENTRY_DSN=
